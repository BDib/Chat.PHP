# Database Configuration
# Supported drivers: sqlite, mysql, pgsql
DB_DRIVER=sqlite

# For SQLite, the path is relative to the root directory
DB_PATH=db/chat.db
FILES_DB_PATH=db/files.db

# For MySQL / PostgreSQL
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=chat
# DB_USER=root
# DB_PASS=secret

# Application Settings
APP_TITLE=Chat
APP_ENV=production
APP_LANG=en
