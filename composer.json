{
    "name": "bdib/chat-php",
    "description": "A modernized, refactored single-file PHP chat application.",
    "license": "MIT",
    "authors": [
        {
            "name": "B Dib"
        }
    ],
    "require": {
        "php": ">=8.3",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "config": {
        "process-timeout": 0,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    }
}
