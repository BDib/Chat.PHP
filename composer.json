{
    "name": "bdib/chat-php",
    "description": "A modernized, refactored single-file PHP chat application.",
    "license": "MIT",
    "authors": [
        {
            "name": "B Dib"
        }
    ],
    "require": {
        "php": ">=8.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "process-timeout": 0,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
